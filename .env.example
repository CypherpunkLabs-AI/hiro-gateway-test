HIRO_BIND_ADDRESS=0.0.0.0:8080
DOCUMENT_ROUTER_URL=http://hiro-document-router:8081/v1/convert/file
DOCUMENT_VISION_BIND=0.0.0.0:8082
DOCUMENT_VISION_MODEL=REPLACE_WITH_ATTESTED_VISION_MODEL
DOCUMENT_VISION_BROKER_TOKEN=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DSTACK_ENDPOINT=/var/run/dstack.sock

PHALA_ACI_BASE_URL=https://REPLACE_WITH_ACI_ENDPOINT
PHALA_API_KEY=REPLACE_WITH_CONFIDENTIALLY_INJECTED_SECRET
PHALA_ACI_ACCEPTED_SUBJECTS=app-id:0xREPLACE_WITH_MEASURED_APP_ID
PHALA_ACI_ACCEPTED_KMS_ROOT_KEYS=REPLACE_WITH_DSTACK_KMS_ROOT_PUBLIC_KEY
PHALA_ACI_PCCS_URL=
PHALA_ACI_VERIFIER_CACHE_SECONDS=300
PHALA_CONNECT_TIMEOUT_SECONDS=10
PHALA_ATTESTATION_TIMEOUT_SECONDS=20
PHALA_READ_TIMEOUT_SECONDS=600

HIRO_KEYSET_TTL_SECONDS=2592000
HIRO_RECEIPT_TTL_SECONDS=3600
HIRO_SOURCE_REPOSITORY=https://github.com/cypherpunklabs-ai/hiro-proxy
HIRO_SOURCE_COMMIT=REPLACE_WITH_FULL_COMMIT_SHA
HIRO_IMAGE_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
HIRO_ATTESTED_SUBJECT=

RUST_LOG=hiro_proxy=info,private_ai_gateway=info

# Application inference; existing quota tables and usage consumer are retained.
DATABASE_URL=postgres://REPLACE_WITH_DATABASE?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=20
CACHE_NAMESPACE_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
INFERENCE_SYSTEM_PROMPT=REPLACE_WITH_HIRO_SYSTEM_PROMPT
INFERENCE_TEMPERATURE=0.7
INFERENCE_MAX_TOKENS=32000
INFERENCE_MAX_CONCURRENCY=1000
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_32_HEX_CHARACTERS
CLOUDFLARE_USAGE_QUEUE_ID=REPLACE_WITH_32_HEX_CHARACTERS
CLOUDFLARE_QUEUES_API_TOKEN=REPLACE_WITH_CONFIDENTIALLY_INJECTED_SECRET
USAGE_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
