module(name = "hiro_proxy")

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "oak")

archive_override(
    module_name = "oak",
    urls = ["https://github.com/project-oak/oak/archive/8fe08a5f80c768613e8287a5a50bb1dd80c6d978.tar.gz"],
    strip_prefix = "oak-8fe08a5f80c768613e8287a5a50bb1dd80c6d978",
    integrity = "sha256-JfjClLUVCbw2tqe0H01F4DIEFk3mwoE4NuOPXUFARVM=",
)

oak_toolchains = use_extension("@oak//bazel/rust:extensions.bzl", "rust_toolchains")
use_repo(oak_toolchains, "oak_rust_linux__x86_64-unknown-linux-gnu__nightly")
register_toolchains("@oak_rust_linux__x86_64-unknown-linux-gnu__nightly//:all")

oak_crates = use_extension("@oak//bazel/crates:extensions.bzl", "aliased_crates_repository")
use_repo(oak_crates, "oak_crates_index")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "proxy_crates",
    manifests = ["//:Cargo.toml"],
    cargo_lockfile = "//:Cargo.lock",
    skip_cargo_lockfile_overwrite = True,
    generate_build_scripts = True,
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)

# Oak protobuf messages and Hiro's Message calls must share one trait identity.
crate.annotation(
    crate = "prost",
    repositories = ["proxy_crates"],
    override_target_lib = "@oak_crates_index//:prost",
)
# AWS-LC's CMake build preserves jitterentropy's mandatory per-source -O0
# after Bazel's release CFLAGS. Use the upstream-supported builder, unpatched.
crate.annotation(
    crate = "aws-lc-sys",
    repositories = ["proxy_crates", "dstack_crates"],
    build_script_env = {"AWS_LC_SYS_CMAKE_BUILDER": "1"},
)
use_repo(crate, "proxy_crates")

# Keep upstream's decoder unmodified. Its QVL dependency has a different
# exact webpki pin from the application verifier and must resolve independently.
crate.spec(
    package = "dstack-attest",
    repositories = ["dstack_crates"],
    git = "https://github.com/Dstack-TEE/dstack.git",
    rev = "3c877847e71a205a1d036965b8f5d671b3740103",
    default_features = False,
)
[
    crate.spec(
        package = package,
        repositories = ["dstack_crates"],
        git = "https://github.com/Dstack-TEE/dstack.git",
        rev = "3c877847e71a205a1d036965b8f5d671b3740103",
        default_features = False,
    )
    for package in ["ra-tls", "dstack-verifier"]
]
# This graph has a separate Tokio crate identity. Run its network verifier on
# its own runtime rather than polling it under the application's Tokio reactor.
crate.spec(
    package = "tokio",
    repositories = ["dstack_crates"],
    version = "=1.53.2",
    features = ["full"],
)
crate.from_specs(
    name = "dstack_crates",
    generate_build_scripts = True,
    supported_platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "dstack_crates")

# Cargo-aware SCALE derives need the upstream workspace's package aliases.
# Generate compile-time manifests without modifying any upstream source files.
[
    crate.annotation(
        crate = name,
        repositories = ["dstack_crates"],
        compile_data = [":macro_manifest"],
        rustc_env_files = [":macro_manifest_env"],
        additive_build_file_content = """
load("@@//build:macro_manifest.bzl", "macro_manifest")
macro_manifest(
    name = "macro_manifest",
    package_manifest = "Cargo.toml",
    workspace_manifest = ".tmp_git_root/dstack/Cargo.toml",
)
filegroup(
    name = "macro_manifest_env",
    srcs = [":macro_manifest"],
    output_group = "environment",
)
""",
    )
    for name in ["dstack-types", "cc-eventlog", "dstack-attest", "dstack-mr", "ra-tls", "tpm-types", "tpm-attest", "tdx-attest"]
]
